<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_instituto" model="ir.module.category">
        <field name="name">Gestión Escolar</field>
        <field name="description">Niveles de acceso para el sistema del instituto</field>
    </record>

    <record id="group_instituto_profe" model="res.groups">
        <field name="name">Profesor</field>
        <field name="category_id" ref="module_category_instituto"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_instituto_tutor" model="res.groups">
        <field name="name">Tutor</field>
        <field name="category_id" ref="module_category_instituto"/>
        <field name="implied_ids" eval="[(4, ref('group_instituto_profe'))]"/>
    </record>

    <record id="group_instituto_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_instituto"/>
        <field name="implied_ids" eval="[(4, ref('group_instituto_tutor'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Reglas de Registro (Record Rules) -->
    
    <record id="rule_parte_profesor_propios" model="ir.rule">
        <field name="name">Profesores solo ven sus propios partes</field>
        <field name="model_id" ref="model_instituto_parte"/>
        <field name="groups" eval="[(4, ref('group_instituto_profe'))]"/>
        <field name="domain_force">['|', ('profesor_id.user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_parte_tutor_grupo" model="ir.rule">
        <field name="name">Tutores ven sus partes y los de su grupo</field>
        <field name="model_id" ref="model_instituto_parte"/>
        <field name="groups" eval="[(4, ref('group_instituto_tutor'))]"/>
        <field name="domain_force">['|', '|', ('profesor_id.user_id', '=', user.id), ('create_uid', '=', user.id), ('grupo_id.tutor_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_alumno_tutor_grupo" model="ir.rule">
        <field name="name">Tutores ven solo sus alumnos</field>
        <field name="model_id" ref="model_instituto_alumno"/>
        <field name="groups" eval="[(4, ref('group_instituto_tutor'))]"/>
        <field name="domain_force">[('grupo_ids.tutor_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_alumno_admin_todos" model="ir.rule">
        <field name="name">Admins ven todos los alumnos</field>
        <field name="model_id" ref="model_instituto_alumno"/>
        <field name="groups" eval="[(4, ref('group_instituto_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_parte_admin_todos" model="ir.rule">
        <field name="name">Admins ven todos los partes</field>
        <field name="model_id" ref="model_instituto_parte"/>
        <field name="groups" eval="[(4, ref('group_instituto_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>