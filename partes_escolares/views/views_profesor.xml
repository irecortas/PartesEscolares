<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_profesor_tree" model="ir.ui.view">
        <field name="name">instituto.profesor.tree</field>
        <field name="model">instituto.profesor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Nombre del Docente"/>
                <field name="cedula"/>
                <field name="email"/>
            </tree>
        </field>
    </record>

    <record id="view_profesor_form" model="ir.ui.view">
        <field name="name">instituto.profesor.form</field>
        <field name="model">instituto.profesor</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_user" string="Crear Usuario Odoo" type="object" 
                            class="btn-primary" attrs="{'invisible': [('user_id', '!=', False)]}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Nombre del Docente"/>
                        <h1><field name="name" placeholder="Ej. Juan Pérez"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="cedula"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="user_role" attrs="{'invisible': [('user_id', '!=', False)], 'required': [('user_id', '=', False)]}"/>
                        </group>
                    </group>


                </sheet>
            </form>
        </field>
    </record>
</odoo>